# 服务配置
PORT=4000
FRONTEND_URL=http://localhost:5173

# Spotify API（可选，无 Key 时使用本地音乐）
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# TTS 语音合成
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY= # Gemini API
COSYVOICE_API_URL=http://localhost:50000 # CosyVoice 本地部署（需要 GPU）
# MOSS-TTS-Nano 本地部署（CPU 可运行）
MOSS_TTS_API_URL=http://localhost:18083
# GPT-SoVITS 声音克隆（免费开源，中文/粤语效果顶级）
# 部署: https://github.com/RVC-Boss/GPT-SoVITS
# 启动: python api.py -a 0.0.0.0 -p 9880
# 声音克隆: 在 backend/data/voices/ 放 .wav 参考音频
GPTSOVITS_API_URL=http://localhost:9880
DEFAULT_TTS_PROVIDER=edge # 🔥 推荐！Edge TTS 完全免费，粤语质量超棒
DEFAULT_TTS_VOICE=alloy # Edge 粤语语音: alloy(婉龙), nova(晓佳), shimmer(晓曼)

# 其他 API
WEATHER_API_KEY= # 可选，用于天气相关的旁白文案

# 网易云音乐 API (用于补充 Wiki 事实和热评)
# 推荐部署: https://github.com/Binaryify/NeteaseCloudMusicApi
NETEASE_API_URL=http://localhost:3000
NETEASE_API_ENABLED=true

# 本地音乐
LOCAL_MUSIC_PATH=/path/to/your/music/folder
PREFERRED_MUSIC_SOURCE=local # local / spotify

# 小米音响（通过 xiaomusic 侧边服务）
# 需要先启动 xiaomusic: https://github.com/hanxi/xiaomusic
# Docker: docker run -d -e MI_USER=账号 -e MI_PASS=密码 -p 8090:8090 hanxi/xiaomusic
XIAOMI_SPEAKER_ENABLED=false
XIAOMI_SPEAKER_API_URL=http://localhost:8090
XIAOMI_SPEAKER_DEVICE_ID=
XIAOMI_SPEAKER_LAN_HOST= # 本机局域网 IP，用于生成音响可访问的音频 URL（留空自动检测）
